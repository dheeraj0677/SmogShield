# SmogShield Backend Environment Variables
# Copy this file to .env and add your keys (never commit .env!)

# OpenRouter API Key (https://openrouter.ai/) — free models only
# Optional: Preferred LLM when set; falls back to Gemini or rule engine if omitted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Google Gemini API Key (https://ai.google.dev/)
# Optional: Used if OPENROUTER_API_KEY is omitted; falls back to rule engine if omitted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Air Quality API Key (optional; falls back to WAQI or keyless Open-Meteo)
GOOGLE_AIR_QUALITY_API_KEY=

# World Air Quality Index Token (https://aqicn.org/api/)
# Optional: If omitted, SmogShield automatically queries Open-Meteo live AQI (keyless).
WAQI_API_TOKEN=

# OpenWeatherMap API Key (https://openweathermap.org/api)
# Optional: If omitted, SmogShield automatically queries Open-Meteo live weather (keyless).
OPENWEATHER_API_KEY=

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL_SECONDS=900
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_AQI_PER_MIN=60
REQUEST_TIMEOUT_SECONDS=10.0

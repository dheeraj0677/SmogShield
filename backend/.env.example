# SmogShield Backend Environment Variables
# Copy this file to .env and add your keys (never commit .env!)

# Google Gemini API Key (https://ai.google.dev/)
# Optional: If omitted, SmogShield uses its rule-based intelligent fallback advisor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# World Air Quality Index Token (https://aqicn.org/api/)
# Optional: If omitted, SmogShield automatically queries Open-Meteo live AQI (keyless).
WAQI_API_TOKEN=

# OpenWeatherMap API Key (https://openweathermap.org/api)
# Optional: If omitted, SmogShield automatically queries Open-Meteo live weather (keyless).
OPENWEATHER_API_KEY=

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL_SECONDS=900
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_AQI_PER_MIN=60
REQUEST_TIMEOUT_SECONDS=10.0
